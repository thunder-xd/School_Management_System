<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>


<?import javafx.scene.control.TextArea?>
<VBox xmlns="http://javafx.com/javafx/17.0.1" xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@../StylingFiles/admin-dashboard-style.css"
      fx:controller="ControllerFiles.AdminDashboardController" spacing="10" style="-fx-padding: 10;">

    <TabPane>


        <Tab text="Students">
            <VBox spacing="10" style="-fx-padding: 10;">
                <Label text="Update Student Information" style="-fx-font-size: 18px;"/>

                <Label text="Name:"/>
                <TextField fx:id="nameField" promptText="Enter Name" prefWidth="300"/>

                <Label text="Marks:"/>
                <TextField fx:id="marksField" promptText="Enter Marks" prefWidth="300"/>

                <Label text="Attendance:"/>
                <TextField fx:id="attendanceField" promptText="Enter Attendance %" prefWidth="300"/>

                <Label text="Phone Number:"/>
                <TextField fx:id="phoneField" promptText="Enter Phone Number" prefWidth="300"/>

                <Button fx:id="saveButtonStudent" text="Save" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" onAction="#onUpdateStudentDetails"/>
            </VBox>
        </Tab>


        <Tab text="Teachers">
            <VBox spacing="10" style="-fx-padding: 10;">

                <Label text="Update Teacher Information" style="-fx-font-size: 18px;"/>

                <Label text="Name:"/>
                <TextField fx:id="nameFieldTeach" promptText="Enter Name" prefWidth="300"/>

                <Label text="Subject Taught:"/>
                <TextField fx:id="subjectField" promptText="Enter Subject" prefWidth="300"/>

                <Label text="Teaching Score:"/>
                <TextField fx:id="scoreField" promptText="Enter Teaching Score" prefWidth="300"/>

                <Label text="Contact Info:"/>
                <TextField fx:id="contactField" promptText="Enter Contact Info" prefWidth="300"/>

                <Label text="Feedback:"/>
                <TextArea fx:id="feedbackArea" promptText="Enter Feedback" prefWidth="300" prefHeight="100"/>

                <Button fx:id="saveButtonTeacher" text="Save" style="-fx-background-color: #4A90E2; -fx-text-fill: white;"/>
            </VBox>
        </Tab>


    </TabPane>


    <Button text="Logout" onAction="#onLogout"/>
</VBox>
