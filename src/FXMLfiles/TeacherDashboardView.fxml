<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.control.TextArea?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>


<VBox xmlns="http://javafx.com/javafx/17.0.1" xmlns:fx="http://javafx.com/fxml/1"
      stylesheets="@../StylingFiles/teacher-dashboard-style.css"
      fx:controller="ControllerFiles.TeacherDashboardController" spacing="10" style="-fx-padding: 10;">
    <TabPane>

        <Tab text="Profile">
            <VBox spacing="10" style="-fx-padding: 10;">
                <Label text="Profile Viewer" style="-fx-font-size: 22px; -fx-text-fill: #2d2d2d;">
                    <font>
                        <Font size="22"/>
                    </font>
                </Label>
                <Label fx:id="nameLabel"  style="-fx-font-size: 16px;"/>
                <Label fx:id="contactLabel"  style="-fx-font-size: 14px;"/>
                <Label fx:id="subjectLabel" style="-fx-font-size: 15px;"/>
                <Label fx:id="scoreLabel" style="-fx-font-size: 15px;"/>
                <TextArea fx:id="feedbackArea" editable="false" wrapText="true" prefHeight="90" style="-fx-font-size: 14px;"/>
            </VBox>
        </Tab>

        <Tab text="Marks">
            <VBox spacing="10" style="-fx-padding: 10;">
                <Label text="Update Marks" style="-fx-font-size: 20px;"/>

                <!-- Subject 1 -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Subject 1:" prefWidth="120"/>
                    <Label fx:id="prevMarks1" text="Previous: 85" prefWidth="120"/>
                    <TextField fx:id="currentMarks1" promptText="Enter current marks" prefWidth="150"/>
                </HBox>

                <!-- Subject 2 -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Subject 2:" prefWidth="120"/>
                    <Label fx:id="prevMarks2" text="Previous: 90" prefWidth="120"/>
                    <TextField fx:id="currentMarks2" promptText="Enter current marks" prefWidth="150"/>
                </HBox>

                <!-- Subject 3 -->
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Subject 3:" prefWidth="120"/>
                    <Label fx:id="prevMarks3" text="Previous: 88" prefWidth="120"/>
                    <TextField fx:id="currentMarks3" promptText="Enter current marks" prefWidth="150"/>
                </HBox>

                <Button fx:id="updateMarksButton" text="Update Marks" style="-fx-background-color: #4a90e2; -fx-text-fill: white;"/>
            </VBox>
        </Tab>


        <Tab text="Attendance">
            <VBox spacing="15" style="-fx-padding: 15;">
                <Label text="Attendance Update" style="-fx-font-size: 20px;"/>

                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Student ID:" style="-fx-font-size: 16px;"/>
                    <TextField fx:id="studentIdField" promptText="Enter Student ID" />
                </HBox>

                <Label fx:id="currentAttendanceLabel" style="-fx-font-size: 16px;"/>

                <VBox spacing="5">
                    <Label text="Subject 1" style="-fx-font-weight: bold;"/>
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <Button fx:id="subject1PresentButton" text="Present" onAction="#onSubject1Selected" styleClass="attendance-button"/>
                        <Button fx:id="subject1AbsentButton" text="Absent" onAction="#onSubject1Selected" styleClass="attendance-button"/>
                    </HBox>
                </VBox>

                <VBox spacing="5">
                    <Label text="Subject 2" style="-fx-font-weight: bold;"/>
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <Button fx:id="subject2PresentButton" text="Present" onAction="#onSubject2Selected" styleClass="attendance-button"/>
                        <Button fx:id="subject2AbsentButton" text="Absent" onAction="#onSubject2Selected" styleClass="attendance-button"/>
                    </HBox>
                </VBox>

                <VBox spacing="5">
                    <Label text="Subject 3" style="-fx-font-weight: bold;"/>
                    <HBox spacing="14" alignment="CENTER_LEFT">
                        <Button fx:id="subject3PresentButton" text="Present" onAction="#onSubject3Selected" styleClass="attendance-button"/>
                        <Button fx:id="subject3AbsentButton" text="Absent" onAction="#onSubject3Selected" styleClass="attendance-button"/>
                    </HBox>
                </VBox>

                <Button fx:id="commitButton" text="Commit Attendance" style="-fx-background-color: #58b368; -fx-text-fill: white;" onAction="#onUpdateAttendance"/>
            </VBox>
        </Tab>

    </TabPane>
    <Button text="Logout" onAction="#onLogout"/>
</VBox>
